---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Shorter description for link previews; defaults to `description`. */
  ogDescription?: string;
}

const { title, description, ogDescription = description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/cv_photo.jpg', Astro.site);

const navLinks = [
  { href: '/home/', label: 'Curriculum' },
  { href: '/games/', label: 'Games' },
];
const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Link previews (LinkedIn, WhatsApp, Slack, ...) -->
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content="Koen Van Aken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="480" />
    <meta property="og:image:height" content="480" />
    <meta property="og:image:alt" content="Portretfoto van Koen Van Aken" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <nav class="navbar">
      <span class="navbar-brand">Koen Van Aken</span>
      <div class="navbar-nav">
        {
          navLinks.map(({ href, label }) => (
            <a
              class:list={['nav-link', { active: isActive(href) }]}
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          ))
        }
      </div>
    </nav>
    <div class="content"><slot /></div>
    <footer class="site-footer">&copy; Koen Van Aken 2024</footer>
  </body>
</html>

<style>
  .content {
    padding: 5rem 0 0 2rem;
  }

  .navbar-brand {
    margin-right: 4rem;
  }

  /* Leave room on the right and for the Export button at the bottom */
  @media screen and (max-width: 768px) {
    .content {
      padding: 5rem 2rem 4rem;
    }
  }

  @media screen and (max-width: 576px) {
    .content {
      padding: 4.5rem 1rem 4rem;
    }

    .navbar-brand {
      margin-right: 1rem;
    }
  }

  @media print {
    nav {
      display: none;
    }

    .content {
      padding: 0;
    }
  }
</style>
